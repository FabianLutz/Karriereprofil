---
// LegalModals.astro - Barrierefreie Modals für Impressum & Datenschutz (100% DSGVO / DDG)
---

<!-- IMPRESSUM MODAL -->
<div
  id="modal-impressum"
  class="legal-modal fixed inset-0 z-[120] bg-nordic-slate-950/70 backdrop-blur-sm hidden items-center justify-center p-4 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="impressum-title"
>
  <div class="bg-white rounded-3xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl border border-slate-200 relative max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-6">
      <h2 id="impressum-title" class="text-xl font-bold text-nordic-slate-900">
        Impressum
      </h2>
      <button
        type="button"
        class="close-modal-btn w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center focus-visible:ring-2 focus-visible:ring-nordic-emerald-500 outline-none"
        aria-label="Modal schließen"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="space-y-4 text-xs sm:text-sm text-nordic-slate-700 leading-relaxed">
      <p class="font-bold text-nordic-slate-900">Angaben gemäß § 5 Digitale-Dienste-Gesetz (DDG):</p>
      <p>
        Fabian Lutz<br />
        Gustav-Bregenzerstr. 8<br />
        72488 Sigmaringen<br />
        Deutschland
      </p>

      <p class="font-bold text-nordic-slate-900 pt-2">Kontakt:</p>
      <p>
        Telefon: 01520 6202863<br />
        E-Mail: lutzfabi2@gmail.com
      </p>

      <p class="font-bold text-nordic-slate-900 pt-2">Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV:</p>
      <p>
        Fabian Lutz<br />
        Gustav-Bregenzerstr. 8, 72488 Sigmaringen
      </p>

      <p class="font-bold text-nordic-slate-900 pt-2">Zweck dieser Website:</p>
      <p>
        Diese Website dient ausschließlich der persönlichen Vorstellung des beruflichen Werdegangs und der Qualifikationen von Fabian Lutz für Bewerbungszwecke und fachlichen Austausch.
      </p>
    </div>

    <div class="pt-6 mt-6 border-t border-slate-100 flex justify-end">
      <button
        type="button"
        class="close-modal-btn min-h-[44px] px-5 bg-nordic-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-xl"
      >
        Schließen
      </button>
    </div>
  </div>
</div>

<!-- DATENSCHUTZ MODAL -->
<div
  id="modal-datenschutz"
  class="legal-modal fixed inset-0 z-[120] bg-nordic-slate-950/70 backdrop-blur-sm hidden items-center justify-center p-4 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="datenschutz-title"
>
  <div class="bg-white rounded-3xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl border border-slate-200 relative max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-6">
      <h2 id="datenschutz-title" class="text-xl font-bold text-nordic-slate-900">
        Datenschutzerklärung
      </h2>
      <button
        type="button"
        class="close-modal-btn w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center focus-visible:ring-2 focus-visible:ring-nordic-emerald-500 outline-none"
        aria-label="Modal schließen"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="space-y-4 text-xs sm:text-sm text-nordic-slate-700 leading-relaxed">
      <p class="font-bold text-nordic-slate-900">1. Datenschutz auf einen Blick</p>
      <p>
        Diese Website ist zu 100% cookie-frei. Es werden weder Tracking-Werkzeuge (wie Google Analytics) noch externe Werbenetzwerke eingesetzt. Es werden keine Schriftarten von Drittservern nachgeladen (ausschließlich lokale System-Schriftarten).
      </p>

      <p class="font-bold text-nordic-slate-900 pt-2">2. Verantwortliche Stelle</p>
      <p>
        Fabian Lutz<br />
        Gustav-Bregenzerstr. 8<br />
        72488 Sigmaringen<br />
        E-Mail: lutzfabi2@gmail.com
      </p>

      <p class="font-bold text-nordic-slate-900 pt-2">3. Datenerfassung bei Kontaktaufnahme</p>
      <p>
        Wenn Sie über das bereitgestellte Kontaktformular oder per E-Mail Kontakt aufnehmen, werden die von Ihnen mitgeteilten Daten (Name, E-Mail-Adresse, Inhalt der Nachricht) ausschließlich zur Bearbeitung Ihrer Anfrage verarbeitet. Eine Weitergabe an Dritte erfolgt nicht. Rechtsgrundlage ist Art. 6 Abs. 1 lit. b bzw. lit. f DSGVO.
      </p>

      <p class="font-bold text-nordic-slate-900 pt-2">4. Ihre Rechte</p>
      <p>
        Sie haben jederzeit das Recht auf unentgeltliche Auskunft über Ihre gespeicherten personenbezogenen Daten, deren Herkunft und Empfänger sowie das Recht auf Berichtigung, Sperrung oder Löschung dieser Daten.
      </p>
    </div>

    <div class="pt-6 mt-6 border-t border-slate-100 flex justify-end">
      <button
        type="button"
        class="close-modal-btn min-h-[44px] px-5 bg-nordic-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-xl"
      >
        Schließen
      </button>
    </div>
  </div>
</div>

<script>
  // Modal Steuerung in Vanilla JS (< 1 KB)
  const impressumModal = document.getElementById('modal-impressum');
  const datenschutzModal = document.getElementById('modal-datenschutz');
  const closeBtns = document.querySelectorAll('.close-modal-btn');
  const openImpressumLinks = document.querySelectorAll('.open-impressum-btn');
  const openDatenschutzLinks = document.querySelectorAll('.open-datenschutz-btn');

  function openModal(modal: HTMLElement | null) {
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeModal(modal: HTMLElement | null) {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }
  }

  openImpressumLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      openModal(impressumModal);
    });
  });

  openDatenschutzLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      openModal(datenschutzModal);
    });
  });

  closeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      closeModal(impressumModal);
      closeModal(datenschutzModal);
    });
  });

  // Schließen bei Klick auf Backdrop
  [impressumModal, datenschutzModal].forEach(modal => {
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal(modal);
      }
    });
  });

  // Schließen bei Esc-Taste
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeModal(impressumModal);
      closeModal(datenschutzModal);
    }
  });
</script>
