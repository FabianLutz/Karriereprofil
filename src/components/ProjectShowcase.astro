        <!-- 3-Wege-Wippe / Segment-Schalter -->
        <div class="flex bg-slate-100 p-1 rounded-2xl mb-5" role="tablist">
          <button
            type="button"
            data-tab="problem"
            class="project-tab-btn active flex-1 py-2 text-xs font-semibold rounded-xl transition-all duration-150 bg-white text-nordic-slate-900 shadow-xs"
            role="tab"
            aria-selected="true"
          >
            Ausgangslage
          </button>
          <button
            type="button"
            data-tab="solution"
            class="project-tab-btn flex-1 py-2 text-xs font-semibold rounded-xl transition-all duration-150 text-nordic-slate-600 hover:text-nordic-slate-900"
            role="tab"
            aria-selected="false"
          >
            Lösungsarchitektur
          </button>
          <button
            type="button"
            data-tab="result"
            class="project-tab-btn flex-1 py-2 text-xs font-semibold rounded-xl transition-all duration-150 text-nordic-slate-600 hover:text-nordic-slate-900"
            role="tab"
            aria-selected="false"
          >
            Messbarer Wert
          </button>
        </div>

        <!-- Content-Container -->
        <div class="project-content-container min-h-[140px] text-sm text-nordic-slate-700">
          <!-- Ausgangslage -->
          <div class="tab-pane tab-problem">
            <p class="leading-relaxed">
              Hersteller chirurgischer Medizintechnik stehen vor der Herausforderung, margenschwache Einmal-Hardwareverkäufe durch zukunftsfähige Software- und Plattformdienste zu ergänzen. Im regulierten OP-Umfeld bestehen hohe Hürden für neue Abrechnungs- und Nutzungsmodelle.
            </p>
          </div>

          <!-- Lösungsarchitektur -->
          <div class="tab-pane tab-solution hidden">
            <p class="leading-relaxed">
              Durchführung leitfadengestützter Experteninterviews mit C-Level-Führungskräften und chirurgischen Chefärzten. Systematische Evaluation von Pay-per-Use- und Software-as-a-Service-Modellen inklusive Spezifikation technischer Plattformanforderungen (Requirements Engineering).
            </p>
          </div>

          <!-- Messbarer Wert -->
          <div class="tab-pane tab-result hidden">
            <div class="p-3.5 bg-nordic-emerald-50 rounded-xl border border-nordic-emerald-200">
              <p class="text-xs font-bold text-nordic-emerald-900 mb-1">
                Bestnote 1,3 und C-Level-Relevanz:
              </p>
              <p class="text-xs text-nordic-emerald-800 leading-relaxed">
                Handlungsempfehlungen direkt auf Vice-President-Ebene präsentiert. Zeugnis bescheinigt „außergewöhnliche Leistungen und Fähigkeiten“ sowie „ausgezeichnete Arbeitsergebnisse“.
              </p>
            </div>
          </div>
        </div>
