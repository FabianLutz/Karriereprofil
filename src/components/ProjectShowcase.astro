<script>
  // 3-Wege-Wippen Logik in reinem Vanilla JS (< 1.5 KB)
  const projectCards = document.querySelectorAll('.project-card');

  projectCards.forEach(card => {
    const tabButtons = card.querySelectorAll<HTMLButtonElement>('.project-tab-btn');
    const panes = card.querySelectorAll<HTMLElement>('.tab-pane');

    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const tab = button.dataset.tab;

        // Button States
        tabButtons.forEach(b => {
          b.classList.remove('active', 'bg-white', 'text-nordic-slate-900', 'shadow-xs');
          b.classList.add('text-nordic-slate-600');
          b.setAttribute('aria-selected', 'false');
        });

        button.classList.add('active', 'bg-white', 'text-nordic-slate-900', 'shadow-xs');
        button.classList.remove('text-nordic-slate-600');
        button.setAttribute('aria-selected', 'true');

        // Pane Visibility
        panes.forEach(pane => {
          if (pane.classList.contains(`tab-${tab}`)) {
            pane.classList.remove('hidden');
          } else {
            pane.classList.add('hidden');
          }
        });
      });
    });
  });
</script>
