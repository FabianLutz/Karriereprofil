<script>
  // Filter- und Accordion-Logik in Vanilla TypeScript/JS (< 2 KB)
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.timeline-tab-btn');
  const timelineCards = document.querySelectorAll<HTMLElement>('.timeline-card');
  const toggleButtons = document.querySelectorAll<HTMLButtonElement>('.timeline-toggle-btn');

  // Filterung
  tabButtons.forEach(button => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter || 'all';

      tabButtons.forEach(btn => {
        btn.classList.remove('active', 'bg-nordic-slate-900', 'text-white');
        btn.classList.add('bg-white', 'text-nordic-slate-700');
        btn.setAttribute('aria-selected', 'false');
      });

      button.classList.add('active', 'bg-nordic-slate-900', 'text-white');
      button.classList.remove('bg-white', 'text-nordic-slate-700');
      button.setAttribute('aria-selected', 'true');

      timelineCards.forEach(card => {
        const categories = (card.dataset.category || '').split(' ');
        if (filter === 'all' || categories.includes(filter)) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });

  // Accordion Details Toggle
  toggleButtons.forEach(button => {
    button.addEventListener('click', () => {
      const card = button.closest('.timeline-card');
      const details = card?.querySelector('.timeline-details');
      const icon = button.querySelector('.toggle-icon');
      const isExpanded = button.getAttribute('aria-expanded') === 'true';

      if (details) {
        if (isExpanded) {
          details.classList.add('hidden');
          button.setAttribute('aria-expanded', 'false');
          icon?.classList.remove('rotate-180');
        } else {
          details.classList.remove('hidden');
          button.setAttribute('aria-expanded', 'true');
          icon?.classList.add('rotate-180');
        }
      }
    });
  });
</script>
