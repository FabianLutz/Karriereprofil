---
// ContactScheduler.astro - Interaktiver Kontakt- & Interview-Planer mit Anliegen-Vorauswahl
---

<section id="contact" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <!-- Sektions-Header -->
  <div class="max-w-3xl mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-nordic-emerald-50 border border-nordic-emerald-200 text-nordic-emerald-800 text-xs font-semibold mb-3">
      <span class="w-2 h-2 rounded-full bg-nordic-emerald-500"></span>
      Direkte Kontaktaufnahme
    </div>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-nordic-slate-900 tracking-tight mb-4">
      Lassen Sie uns ins Gespräch kommen
    </h2>
    <p class="text-base sm:text-lg text-nordic-slate-600 leading-relaxed">
      Ob kurzes unverbindliches Kennenlernen, konkrete Stellenbesetzung oder Projektanfrage: Wählen Sie Ihr Anliegen aus, um eine passgenaue Nachricht direkt vorzubereiten.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Linke Seite: Interaktives Formular & Themenwahl (7 Spalten) -->
    <div class="lg:col-span-7 bg-white border border-slate-200/80 ring-1 ring-black/5 rounded-3xl p-6 sm:p-8 lg:p-10 shadow-bento">
      <h3 class="text-lg font-bold text-nordic-slate-900 mb-4">
        1. Wählen Sie Ihr Thema:
      </h3>

      <!-- Anliegen-Vorauswahl Chips -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 mb-6" id="topic-selector">
        <button
          type="button"
          data-topic="Kennenlerngespräch (30 Min.)"
          data-subject="Anfrage Kennenlerngespräch mit Fabian Lutz"
          data-body="Guten Tag Herr Lutz, ich würde mich gerne mit Ihnen über eine mögliche Zusammenarbeit und Ihre Erfahrungen in einem kurzen 30-minütigen Gespräch austauschen."
          class="topic-btn active min-h-[48px] px-4 py-2.5 rounded-xl text-xs font-semibold text-left transition-all duration-150 bg-nordic-slate-900 text-white shadow-xs focus-visible:ring-2 focus-visible:ring-nordic-emerald-500 outline-none"
        >
          Kennenlerngespräch (30 Min.)
        </button>

        <button
          type="button"
          data-topic="Festanstellung / Mandat"
          data-subject="Position / Festanstellung für Fabian Lutz"
          data-body="Guten Tag Herr Lutz, Ihr Profil an der Schnittstelle von Digital Business, Enterprise-Systemen und agentischer KI passt hervorragend zu einer Vakanz in unserem Unternehmen. Ich freue mich auf den Dialog."
          class="topic-btn min-h-[48px] px-4 py-2.5 rounded-xl text-xs font-semibold text-left transition-all duration-150 bg-slate-100 hover:bg-slate-200 text-nordic-slate-800 focus-visible:ring-2 focus-visible:ring-nordic-emerald-500 outline-none"
        >
          Festanstellung / Mandat
        </button>

        <button
          type="button"
          data-topic="Projektanfrage / Beratung"
          data-subject="Projektanfrage für Fabian Lutz"
          data-body="Guten Tag Herr Lutz, wir suchen Unterstützung bei digitaler Prozessoptimierung, Enterprise Analytics oder agentischen KI-Workflows und möchten die Rahmenbedingungen besprechen."
          class="topic-btn min-h-[48px] px-4 py-2.5 rounded-xl text-xs font-semibold text-left transition-all duration-150 bg-slate-100 hover:bg-slate-200 text-nordic-slate-800 focus-visible:ring-2 focus-visible:ring-nordic-emerald-500 outline-none"
        >
          Projektanfrage / Beratung
        </button>

        <button
          type="button"
          data-topic="Lebenslauf & Zeugnisse anfordern"
          data-subject="Anforderung vollständiger Lebenslauf & Zeugnisse Fabian Lutz"
          data-body="Guten Tag Herr Lutz, bitte senden Sie mir Ihre vollständigen Bewerbungsunterlagen inklusive Zeugnissen und Notennachweisen per E-Mail zu."
          class="topic-btn min-h-[48px] px-4 py-2.5 rounded-xl text-xs font-semibold text-left transition-all duration-150 bg-slate-100 hover:bg-slate-200 text-nordic-slate-800 focus-visible:ring-2 focus-visible:ring-nordic-emerald-500 outline-none"
        >
          Lebenslauf & Zeugnisse anfordern
        </button>
      </div>

      <!-- Formular -->
      <form id="contact-scheduler-form" class="space-y-4">
        <div>
          <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-nordic-slate-600 mb-1">
            Ihr Name *
          </label>
          <input
            type="text"
            id="contact-name"
            required
            placeholder="z. B. Dr. Sabine Weber"
            class="w-full h-12 px-4 rounded-xl bg-slate-50 border border-slate-200 text-sm text-nordic-slate-900 placeholder-slate-400 focus:bg-white focus-visible:ring-2 focus-visible:ring-nordic-emerald-500 outline-none transition-all"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider text-nordic-slate-600 mb-1">
              Ihre E-Mail-Adresse *
            </label>
            <input
              type="email"
              id="contact-email"
              required
              placeholder="name@unternehmen.de"
              class="w-full h-12 px-4 rounded-xl bg-slate-50 border border-slate-200 text-sm text-nordic-slate-900 placeholder-slate-400 focus:bg-white focus-visible:ring-2 focus-visible:ring-nordic-emerald-500 outline-none transition-all"
            />
          </div>

          <div>
            <label for="contact-company" class="block text-xs font-bold uppercase tracking-wider text-nordic-slate-600 mb-1">
              Unternehmen / Organisation
            </label>
            <input
              type="text"
              id="contact-company"
              placeholder="z. B. MedTech AG / Personalabteilung"
              class="w-full h-12 px-4 rounded-xl bg-slate-50 border border-slate-200 text-sm text-nordic-slate-900 placeholder-slate-400 focus:bg-white focus-visible:ring-2 focus-visible:ring-nordic-emerald-500 outline-none transition-all"
            />
          </div>
        </div>

        <div>
          <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider text-nordic-slate-600 mb-1">
            Ihre Nachricht
          </label>
          <textarea
            id="contact-message"
            rows="4"
            class="w-full p-4 rounded-xl bg-slate-50 border border-slate-200 text-sm text-nordic-slate-900 placeholder-slate-400 focus:bg-white focus-visible:ring-2 focus-visible:ring-nordic-emerald-500 outline-none transition-all"
          >Guten Tag Herr Lutz, ich würde mich gerne mit Ihnen über eine mögliche Zusammenarbeit und Ihre Erfahrungen in einem kurzen 30-minütigen Gespräch austauschen.</textarea>
        </div>

        <!-- Aktions-Buttons -->
        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <button
            type="submit"
            id="submit-mailto-btn"
            class="h-12 px-6 flex-1 flex items-center justify-center bg-nordic-emerald-600 hover:bg-nordic-emerald-700 text-white font-semibold text-sm rounded-xl whitespace-nowrap shadow-sm hover:shadow-emerald-glow transition-all duration-200 focus-visible:ring-2 focus-visible:ring-nordic-emerald-500 outline-none"
          >
            <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            E-Mail vorbereiten & senden
          </button>

          <button
            type="button"
            id="copy-text-btn"
            class="h-12 px-5 flex items-center justify-center bg-slate-100 hover:bg-slate-200 text-nordic-slate-800 font-semibold text-sm rounded-xl whitespace-nowrap transition-colors focus-visible:ring-2 focus-visible:ring-nordic-slate-800 outline-none"
          >
            <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            Text kopieren
          </button>
        </div>

        <!-- Erfolgsmeldung -->
        <div id="contact-feedback" class="hidden p-3 rounded-xl bg-nordic-emerald-50 border border-nordic-emerald-200 text-xs font-semibold text-nordic-emerald-800 text-center">
          Text erfolgreich in die Zwischenablage kopiert!
        </div>
      </form>
    </div>

    <!-- Rechte Seite: Kontaktdaten & PDF-Download (5 Spalten) -->
    <div class="lg:col-span-5 space-y-6">
      
      <!-- Box: Direkte Kontaktdaten -->
      <div class="bg-white border border-slate-200/80 ring-1 ring-black/5 rounded-3xl p-6 sm:p-7 shadow-bento">
        <h3 class="text-base font-bold text-nordic-slate-900 mb-4">
          Direkte Kontaktdaten
        </h3>

        <div class="space-y-4 text-sm">
          <a
            href="mailto:lutzfabi2@gmail.com"
            class="flex items-center gap-3 p-3 rounded-2xl bg-nordic-linen hover:bg-slate-200/70 transition-colors focus-visible:ring-2 focus-visible:ring-nordic-emerald-500 outline-none"
          >
            <div class="w-9 h-9 rounded-xl bg-nordic-emerald-100 text-nordic-emerald-700 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-xs text-nordic-slate-500">E-Mail</p>
              <p class="font-bold text-nordic-slate-900">lutzfabi2@gmail.com</p>
            </div>
          </a>



          <a
            href="https://www.linkedin.com/in/fabian-lutz-459b13169"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-3 rounded-2xl bg-nordic-linen hover:bg-slate-200/70 transition-colors focus-visible:ring-2 focus-visible:ring-nordic-emerald-500 outline-none"
          >
            <div class="w-9 h-9 rounded-xl bg-nordic-emerald-100 text-nordic-emerald-700 flex items-center justify-center shrink-0 font-bold text-xs">
              in
            </div>
            <div>
              <p class="text-xs text-nordic-slate-500">LinkedIn</p>
              <p class="font-bold text-nordic-slate-900">linkedin.com/in/fabian-lutz</p>
            </div>
          </a>

          <div class="flex items-center gap-3 p-3 rounded-2xl bg-nordic-linen">
            <div class="w-9 h-9 rounded-xl bg-slate-200 text-nordic-slate-700 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              </svg>
            </div>
            <div>
              <p class="text-xs text-nordic-slate-500">Standort</p>
              <p class="font-bold text-nordic-slate-900">72488 Sigmaringen, Baden-Württemberg</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Box: 1-Klick Druck & PDF-Export -->
      <div class="bg-nordic-slate-900 text-white border border-white/10 rounded-3xl p-6 sm:p-7 shadow-bento-dark">
        <h3 class="text-base font-bold mb-2 text-white">
          Portfolio als PDF drucken / sichern
        </h3>
        <p class="text-xs text-slate-300 leading-relaxed mb-4">
          Nutzen Sie die druckoptimierte Ansicht des Portfolios, um ein sauberes, kompaktes Profil als PDF direkt abzuspeichern.
        </p>
        <button
          type="button"
          id="print-portfolio-btn"
          class="w-full min-h-[48px] px-4 flex items-center justify-center bg-white hover:bg-slate-100 text-nordic-slate-900 text-xs font-bold rounded-xl transition-all shadow-sm focus-visible:ring-2 focus-visible:ring-nordic-emerald-500 outline-none"
        >
          <svg class="w-4 h-4 mr-2 text-nordic-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          Druckansicht aufrufen / als PDF speichern
        </button>
      </div>

    </div>
  </div>
</section>

<script>
  // Topic-Wechsel und Formular-Logik (< 2 KB Vanilla JS)
  const topicBtns = document.querySelectorAll<HTMLButtonElement>('.topic-btn');
  const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
  const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
  const companyInput = document.getElementById('contact-company') as HTMLInputElement | null;
  const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;
  const schedulerForm = document.getElementById('contact-scheduler-form') as HTMLFormElement | null;
  const copyBtn = document.getElementById('copy-text-btn') as HTMLButtonElement | null;
  const feedback = document.getElementById('contact-feedback');
  const printBtn = document.getElementById('print-portfolio-btn');

  let activeSubject = 'Anfrage Kennenlerngespräch mit Fabian Lutz';

  topicBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      topicBtns.forEach(b => {
        b.classList.remove('active', 'bg-nordic-slate-900', 'text-white', 'shadow-xs');
        b.classList.add('bg-slate-100', 'text-nordic-slate-800');
      });

      btn.classList.add('active', 'bg-nordic-slate-900', 'text-white', 'shadow-xs');
      btn.classList.remove('bg-slate-100', 'text-nordic-slate-800');

      activeSubject = btn.dataset.subject || 'Kontaktanfrage';
      if (messageInput && btn.dataset.body) {
        messageInput.value = btn.dataset.body;
      }
    });
  });

  // Mailto Absenden
  schedulerForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = nameInput?.value.trim() || '';
    const email = emailInput?.value.trim() || '';
    const company = companyInput?.value.trim() || '';
    const message = messageInput?.value.trim() || '';

    const bodyText = `${message}\n\nAbsender:\n${name}\n${company ? `Unternehmen: ${company}\n` : ''}E-Mail: ${email}`;
    const mailtoUrl = `mailto:lutzfabi2@gmail.com?subject=${encodeURIComponent(activeSubject)}&body=${encodeURIComponent(bodyText)}`;

    window.location.href = mailtoUrl;
  });

  // Text kopieren
  copyBtn?.addEventListener('click', () => {
    const name = nameInput?.value.trim() || '[Ihr Name]';
    const email = emailInput?.value.trim() || '[Ihre E-Mail]';
    const company = companyInput?.value.trim() || '';
    const message = messageInput?.value.trim() || '';

    const fullText = `Betreff: ${activeSubject}\n\n${message}\n\nAbsender:\n${name}\n${company ? `Unternehmen: ${company}\n` : ''}E-Mail: ${email}`;

    navigator.clipboard.writeText(fullText).then(() => {
      if (feedback) {
        feedback.classList.remove('hidden');
        setTimeout(() => feedback.classList.add('hidden'), 3500);
      }
    });
  });

  // Externe Preset-Buttons (z. B. aus dem Hero-Bento)
  const presetBtns = document.querySelectorAll<HTMLElement>('.cta-preset-btn');
  presetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const presetTopic = btn.dataset.preset;
      if (presetTopic) {
        topicBtns.forEach(tBtn => {
          if (tBtn.dataset.topic === presetTopic) {
            tBtn.click();
          }
        });
      }
    });
  });

  // Drucken
  printBtn?.addEventListener('click', () => {
    window.print();
  });
</script>
