<script>
  // Skill-Filter- & Suchlogik in Vanilla TypeScript/JS (< 2 KB)
  const searchInput = document.getElementById('skill-search-input') as HTMLInputElement | null;
  const clearSearchBtn = document.getElementById('skill-search-clear') as HTMLButtonElement | null;
  const categoryBtns = document.querySelectorAll<HTMLButtonElement>('.skill-cat-btn');
  const skillItems = document.querySelectorAll<HTMLElement>('.skill-item');
  const skillCounter = document.getElementById('skill-counter');
  const skillTotal = document.getElementById('skill-total');
  const noSkillsFound = document.getElementById('no-skills-found');
  const resetFiltersBtn = document.getElementById('reset-skill-filters-btn');

  if (skillTotal) {
    skillTotal.textContent = skillItems.length.toString();
  }
  if (skillCounter) {
    skillCounter.textContent = skillItems.length.toString();
  }

  let activeCategory = 'all';
  let searchQuery = '';

  function applyFilters() {
    let visibleCount = 0;
    const query = searchQuery.trim().toLowerCase();

    skillItems.forEach(item => {
      const itemCat = item.dataset.category || '';
      const itemKeywords = (item.dataset.keywords || '').toLowerCase();
      const itemText = (item.textContent || '').toLowerCase();

      const matchesCat = (activeCategory === 'all') || (itemCat === activeCategory);
      const matchesSearch = !query || itemKeywords.includes(query) || itemText.includes(query);

      if (matchesCat && matchesSearch) {
        item.classList.remove('hidden');
        visibleCount++;
      } else {
        item.classList.add('hidden');
      }
    });

    if (skillCounter) {
      skillCounter.textContent = visibleCount.toString();
    }

    if (noSkillsFound) {
      if (visibleCount === 0) {
        noSkillsFound.classList.remove('hidden');
      } else {
        noSkillsFound.classList.add('hidden');
      }
    }
  }

  // Sucheingabe
  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    if (clearSearchBtn) {
      if (searchQuery.length > 0) {
        clearSearchBtn.classList.remove('hidden');
      } else {
        clearSearchBtn.classList.add('hidden');
      }
    }
    applyFilters();
  });

  // Suche zurücksetzen
  clearSearchBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchQuery = '';
      clearSearchBtn.classList.add('hidden');
      searchInput.focus();
      applyFilters();
    }
  });

  // Kategorie-Klick
  categoryBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      categoryBtns.forEach(b => {
        b.classList.remove('active', 'bg-nordic-slate-900', 'text-white');
        b.classList.add('bg-slate-100', 'text-nordic-slate-700');
      });

      btn.classList.add('active', 'bg-nordic-slate-900', 'text-white');
      btn.classList.remove('bg-slate-100', 'text-nordic-slate-700');

      activeCategory = btn.dataset.category || 'all';
      applyFilters();
    });
  });

  // Reset Button
  resetFiltersBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    searchQuery = '';
    activeCategory = 'all';
    categoryBtns.forEach(b => {
      if (b.dataset.category === 'all') {
        b.classList.add('active', 'bg-nordic-slate-900', 'text-white');
        b.classList.remove('bg-slate-100', 'text-nordic-slate-700');
      } else {
        b.classList.remove('active', 'bg-nordic-slate-900', 'text-white');
        b.classList.add('bg-slate-100', 'text-nordic-slate-700');
      }
    });
    if (clearSearchBtn) clearSearchBtn.classList.add('hidden');
    applyFilters();
  });
</script>
