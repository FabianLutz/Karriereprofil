---
// impressum.astro - Standalone Impressum Seite
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Impressum | Fabian Lutz Karriereportfolio"
  description="Impressum und rechtliche Angaben gemäß § 5 DDG von Fabian Lutz."
  noindex={true}
>
  <Header />

  <main id="main-content" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 flex-grow">
    <div class="bg-white border border-slate-200/80 ring-1 ring-black/5 rounded-3xl p-6 sm:p-10 shadow-bento">
      <h1 class="text-3xl font-extrabold text-nordic-slate-900 mb-6">
        Impressum
      </h1>

      <div class="space-y-6 text-sm text-nordic-slate-700 leading-relaxed">
        <div>
          <h2 class="text-base font-bold text-nordic-slate-900 mb-2">Angaben gemäß § 5 DDG</h2>
          <p>
            Fabian Lutz<br />
            Gustav-Bregenzerstr. 8<br />
            72488 Sigmaringen<br />
            Deutschland
          </p>
        </div>

        <div>
          <h2 class="text-base font-bold text-nordic-slate-900 mb-2">Kontakt</h2>
          <p>
            Telefon: 01520 6202863<br />
            E-Mail: lutzfabi2@gmail.com
          </p>
        </div>

        <div>
          <h2 class="text-base font-bold text-nordic-slate-900 mb-2">Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
          <p>
            Fabian Lutz<br />
            Gustav-Bregenzerstr. 8<br />
            72488 Sigmaringen
          </p>
        </div>

        <div>
          <h2 class="text-base font-bold text-nordic-slate-900 mb-2">Zweck dieser Website</h2>
          <p>
            Diese Website dient der persönlichen Vorstellung des beruflichen Werdegangs und der Qualifikationen von Fabian Lutz für Bewerbungszwecke, Karrierechancen und fachlichen Austausch.
          </p>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-slate-100">
        <a
          href={import.meta.env.BASE_URL}
          class="inline-flex items-center gap-2 text-xs font-semibold text-nordic-emerald-700 hover:text-nordic-emerald-800"
        >
          ← Zurück zum Hauptportfolio
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
