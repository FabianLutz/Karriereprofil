---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = "Fabian Lutz | M.Sc. Digital Business, Agentic AI & Enterprise Systems",
  description = "Karriereportfolio von Fabian Lutz: Digital Business, Agentic AI Orchestration, SAP Analytics und skalierbare Enterprise-Prozesse.",
  canonical = Astro.url.href,
  noindex = false,
} = Astro.props;

const siteUrl = "https://fabzin.github.io/Karriereprofil";

const schemaOrgJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteUrl}/#fabian-lutz`,
      "name": "Fabian Lutz",
      "givenName": "Fabian",
      "familyName": "Lutz",
      "jobTitle": "M.Sc. Digital Business & Agentic AI Architect",
      "description": "Digital Business & Agentic AI Orchestration: Enterprise-Systeme steuern, Prozesse automatisieren und messbaren Wert schaffen.",
      "url": siteUrl,
      "email": "lutzfabi2@gmail.com",
      "telephone": "+4915206202863",
      "image": `${siteUrl}/fabian-lutz.png`,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Gustav-Bregenzerstr. 8",
        "addressLocality": "Sigmaringen",
        "postalCode": "72488",
        "addressRegion": "Baden-Württemberg",
        "addressCountry": "DE"
      },
      "alumniOf": [
        {
          "@type": "EducationalOrganization",
          "name": "Hochschule Albstadt-Sigmaringen",
          "description": "Master of Science in Digital Business and Management (Note 1,4)"
        },
        {
          "@type": "EducationalOrganization",
          "name": "Hochschule Albstadt-Sigmaringen",
          "description": "Bachelor of Science in Betriebswirtschaft (Note 1,9)"
        }
      ],
      "knowsAbout": [
        "Agentic AI & Orchestration",
        "Multi-Agent Systems (Claude Code, Antigravity)",
        "Digital Business & Transformation",
        "SAP ERP / QM",
        "SAP Analytics Cloud",
        "SAP Business Data Cloud",
        "Microsoft Power BI",
        "GAMP 5 & Computer Software Validation (CSV)",
        "GxP & ISO 13485 Compliance",
        "Requirements Engineering",
        "Automatisierte Workflows"
      ],
      "sameAs": [
        "https://www.linkedin.com/in/fabian-lutz-459b13169",
        "https://fabzin.github.io/sap-analytics-portfolio/"
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Fabian Lutz: Karriereportfolio" />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Fabian Lutz: Modern Nordic Editorial Tech Portfolio" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrgJsonLd)} />

    <style is:global>
      /* 100% DSGVO-konformer System-Fontstack: Zero externe Calls, maximale Render-Geschwindigkeit */
      html {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        color-scheme: light;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        background-color: #F8FAFC;
      }

      /* Reduzierte Bewegung respektieren */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }

      /* Barrierefreier Fokusring WCAG AAA */
      a:focus-visible,
      button:focus-visible,
      input:focus-visible,
      select:focus-visible,
      textarea:focus-visible,
      summary:focus-visible {
        outline: 3px solid #10B981 !important;
        outline-offset: 2px !important;
      }

      /* Druckoptimierung: Direkter 2-Seiten Lebenslauf-Export */
      @media print {
        #scroll-progress-bar,
        nav,
        header,
        footer,
        #contact-form-section,
        .no-print {
          display: none !important;
        }
        body {
          background: white !important;
          color: #0F172A !important;
          font-size: 11pt !important;
          line-height: 1.4 !important;
        }
        .bento-card {
          box-shadow: none !important;
          border: 1px solid #CBD5E1 !important;
          break-inside: avoid;
        }
      }
    </style>
  </head>
  <body class="bg-nordic-alabaster text-nordic-slate-800 antialiased min-h-screen flex flex-col selection:bg-nordic-emerald-100 selection:text-nordic-emerald-900">
    <!-- 3px Interaktiver Smaragd-Lesebalken ganz oben -->
    <div
      id="scroll-progress-bar"
      class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-nordic-emerald-600 via-nordic-emerald-500 to-nordic-amber-500 z-[100] transition-[width] duration-100 ease-out pointer-events-none"
      style="width: 0%;"
      role="progressbar"
      aria-label="Lesefortschritt der Karriereseite"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    ></div>

    <!-- Barrierefreier Tastatur-Sprunglink -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-[110] bg-nordic-slate-900 text-white px-5 py-3 rounded-xl font-semibold shadow-2xl ring-2 ring-nordic-emerald-500"
    >
      Direkt zum Hauptinhalt springen
    </a>

    <slot />

    <script>
      // Lesefortschritt-Logik (< 1 KB Vanilla JS)
      const progressBar = document.getElementById('scroll-progress-bar');
      function updateReadingProgress() {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const progress = scrollHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / scrollHeight) * 100)) : 0;
        if (progressBar) {
          progressBar.style.width = `${progress}%`;
          progressBar.setAttribute('aria-valuenow', Math.round(progress).toString());
        }
      }
      window.addEventListener('scroll', updateReadingProgress, { passive: true });
      window.addEventListener('resize', updateReadingProgress, { passive: true });
      updateReadingProgress();
    </script>
  </body>
</html>
